# ========== 对话模型：智谱官方 ==========
# 申请地址：https://open.bigmodel.cn/ （glm-5.3-flash 有 2500 万免费 token）
ZHIPU_API_KEY=your_api_key_here
# 以下两项留空即用 shared/config.py 里的默认值，无需修改
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_CHAT_MODEL=glm-5.3-flash

# ========== Embedding：本地 fastembed ==========
# 本地推理，无需 API Key；模型首次使用会自动下载并缓存，之后可离线运行
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== 对话历史落库（Chainlit） ==========
# 路径留空即用默认 agent/data/chat_history.db；测试请指向临时目录
# CHAT_HISTORY_DB=agent/data/chat_history.db
# 是否把完整 steps（含工具 observation）也存进库，默认 false
# CHAT_HISTORY_STORE_STEPS=false

# ========== 认证（多用户） ==========
# 默认 false：不登录，所有数据归到默认用户 local（行为与之前一致）
# CHAT_AUTH_ENABLED=true 时必须设置 CHAT_ADMIN_PASSWORD，否则启动直接报错
# CHAT_AUTH_ENABLED=false
# CHAT_ADMIN_USER=admin
# CHAT_ADMIN_PASSWORD=
# Chainlit 的 JWT 签名密钥；不设会自动生成并落到 agent/data/.chainlit_secret
# （生产建议显式设置：python -c "import secrets;print(secrets.token_urlsafe(48))"）
# CHAINLIT_AUTH_SECRET=
# 账号管理：python -m agent.chat_history adduser <用户名> <密码>

# ========== 限流 + 成本控制 ==========
# 总开关，默认 true；置 false 时四道闸门**全部**关闭（含 max_tokens 与单次预算），
# 行为与本轮改造之前逐字一致。注意：限流是纯保护，不开认证时也应当生效。
# RATE_LIMIT_ENABLED=true
# 闸门 3 单用户频率：令牌桶（进程内，零 IO）；上多 worker 前必须换成 Redis / 落库窗口
# RATE_PER_MIN=6            # 每分钟补充的请求数
# RATE_BURST=3              # 桶容量（允许连发几次）
# 闸门 1 单次输出上限：0 = 不限；被截断会记 finish_reason=length 并当解析失败处理
# LLM_MAX_TOKENS=1024
# 闸门 2 单次请求累计 token 上限：0 = 不限；触顶**降级收尾，不拒绝请求**
# RUN_TOKEN_BUDGET=30000
# 闸门 4 日额度（真相源是 logs/token_usage.db，重启不丢、跨进程一致）：0 = 不限
# DAILY_TOKENS_PER_USER=200000
# GLOBAL_DAILY_TOKENS=2000000
# 全局并发上限（asyncio.Semaphore）：run_agent 目前在事件循环里同步阻塞
# MAX_CONCURRENCY=3

# ========== 可选开关 ==========
# USE_RERANKER=false
