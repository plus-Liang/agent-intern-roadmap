# ========== 对话模型：任意 OpenAI 兼容服务 ==========
# 申请地址：https://open.bigmodel.cn/ （glm-5.3-flash 有 2500 万免费 token）
ZHIPU_API_KEY=your_api_key_here
# 以下两项留空即用 shared/config.py 里的默认值，无需修改
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_CHAT_MODEL=glm-5.3-flash
#
# 【变量名是历史遗留】ZHIPU_* 只是沿用最早的名字，值可以指向任何
# OpenAI 兼容服务，不限于智谱。换成别家时不用改名，只改值即可，例如 DeepSeek：
#     ZHIPU_API_KEY=sk-xxxxxxxx
#     ZHIPU_BASE_URL=https://api.deepseek.com/v1
#     ZHIPU_CHAT_MODEL=deepseek-chat
# 注意 BASE_URL 只写到 /v1，不要带 /chat/completions（客户端会自己拼）。
# 思考档位参数 reasoning_effort 不是所有网关都认：客户端会自动识别
# 「不支持该参数」的 400 并去掉参数重试，换模型无需改代码。

# ========== Embedding：本地 fastembed ==========
# 本地推理，无需 API Key；模型首次使用会自动下载并缓存，之后可离线运行
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== 对话历史落库（Chainlit） ==========
# 路径留空即用默认 agent/data/chat_history.db；测试请指向临时目录
# CHAT_HISTORY_DB=agent/data/chat_history.db
# 是否把完整 steps（含工具 observation）也存进库，默认 false
# CHAT_HISTORY_STORE_STEPS=false

# ========== 认证（多用户） ==========
# 默认 false：不登录，所有数据归到默认用户 local（行为与之前一致）
# CHAT_AUTH_ENABLED=true 时必须设置 CHAT_ADMIN_PASSWORD，否则启动直接报错
# CHAT_AUTH_ENABLED=false
# CHAT_ADMIN_USER=admin
# CHAT_ADMIN_PASSWORD=
# Chainlit 的 JWT 签名密钥；不设会自动生成并落到 agent/data/.chainlit_secret
# （生产建议显式设置：python -c "import secrets;print(secrets.token_urlsafe(48))"）
# CHAINLIT_AUTH_SECRET=
# 账号管理：python -m agent.chat_history adduser <用户名> <密码>

# ========== 限流 + 成本控制 ==========
# 总开关，默认 true；置 false 时四道闸门**全部**关闭（含 max_tokens 与单次预算），
# 行为与本轮改造之前逐字一致。注意：限流是纯保护，不开认证时也应当生效。
# RATE_LIMIT_ENABLED=true
# 闸门 3 单用户频率：令牌桶（进程内，零 IO）；上多 worker 前必须换成 Redis / 落库窗口
# RATE_PER_MIN=6            # 每分钟补充的请求数
# RATE_BURST=3              # 桶容量（允许连发几次）
# 闸门 1 单次输出上限：0 = 不限；被截断会记 finish_reason=length 并当解析失败处理
# LLM_MAX_TOKENS=1024
# 简历解析单独额度 + 思考档位：glm-5.3-flash 是思考模型，max_tokens 同时卡住
# 思考与正文，1024 会被思考吃光 → 正文为空、JSON 解析报 Expecting value
# RESUME_LLM_MAX_TOKENS=4096
# RESUME_LLM_REASONING_EFFORT=low      # low / high / max
# ReAct 长输出轮（「查看我的完整简历」这类要复述长内容）单独额度 + 思考档位。
# 判据：上一轮被截断 / 上一轮工具返回 ≥800 字符 / 问题含「完整/全部/列全/详细…」。
# 日常工具调用轮仍走 LLM_MAX_TOKENS（实测 176 token 就收尾，不需要更大额度）。
# REACT_LLM_LONG_MAX_TOKENS=8192
# REACT_LLM_REASONING_EFFORT=low       # low / high / max
# 闸门 2 单次请求累计 token 上限：0 = 不限；触顶**降级收尾，不拒绝请求**
# RUN_TOKEN_BUDGET=30000
# LangGraph 反思节点（agent/langgraph_flow.py）的「虚高」警戒线：
# 分数**严格高于**该值、且岗位**关键项**（requirements 段 / 带「熟悉·必须·精通」措辞的句子）
# 在简历里找不到证据 → 判虚高，并把分数拉回警戒线（回到线下即收敛；最多重打 2 次只是安全网）。
# LG_REFLECT_INFLATION_SCORE=85
# 关键项覆盖不足（<50%）时降到的低警戒线：
# LG_REFLECT_INFLATION_SCORE_LOW=70
# 收敛阈值：建议修正的绝对值小于它就算分数已稳定，不再重打（也用于「连续两次复核分数变化 <5」）：
# LG_REFLECT_CONVERGENCE_DELTA=5
# Agent 入口引擎：langgraph（默认，搜岗位 / 匹配打分走图）/ react（整体切回旧版 ReAct）
# AGENT_ENGINE=langgraph
# 闸门 4 日额度（真相源是 logs/token_usage.db，重启不丢、跨进程一致）：0 = 不限
# DAILY_TOKENS_PER_USER=200000
# GLOBAL_DAILY_TOKENS=2000000
# 全局并发上限（asyncio.Semaphore）：run_agent 目前在事件循环里同步阻塞
# MAX_CONCURRENCY=3

# ========== 可选开关 ==========
# USE_RERANKER=false

# ========== 路径与运行期位置（可选，留空用默认） ==========
# fastembed 模型缓存目录，默认 ~/.cache/fastembed；容器里建议指到持久盘，避免反复下载
# FASTEMBED_CACHE_PATH=
# 用量库（限流日额度的真相源，重启不丢）与反馈库
# TOKEN_DB_PATH=logs/token_usage.db
# FEEDBACK_DB_PATH=logs/feedback.db
# 对话历史注入的消息条数上限；留空用代码默认，小于 3 会被当成非法值忽略
# MAX_HISTORY=

# ========== 抓取（只在需要自己更新数据时配置） ==========
# 完整抓取配置在 config/scraping.yaml，下面这些环境变量优先级更高
# SCHEDULER_PLATFORMS=shixiseng,niuke,ncss
# SCHEDULER_CITY=广州,深圳,北京,上海,杭州,成都
# SCHEDULER_KEYWORDS=
# 单晚抓取组合数（0 = 全量，很慢：ncss 自带 1 req/s 限速）
# SCHEDULER_BATCH_SIZE=180
# SCHEDULER_CHUNK_SIZE=12
# 抓取需要 Chromium：pip install -r requirements-crawl.txt && python -m playwright install chromium
