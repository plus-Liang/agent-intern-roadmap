  "test_resume": {
    "name": "测试候选人",
    "education": "硕士研究生",
    "city": "广州",
    "skills": ["Python", "RAG", "LangChain", "Agent", "Milvus", "Prompt工程", "FastAPI", "Docker"],
    "experience": [
      "2025.07-2025.10 智元科技（广州）AI 应用开发实习生：负责岗位问答机器人后端，用 RAG + 向量检索把 FAQ 命中率从 62% 提到 89%，接口 P95 延迟约 400ms"
