# Dockerfile.dashboard 专属 ignore 文件（BuildKit 约定：<Dockerfile 路径>.dockerignore）。
#
# 与根目录 .dockerignore 的唯一区别：**不排除 dashboard/ 与 .streamlit/**。
# 根 .dockerignore 排除 dashboard/ 是对的（app 镜像不需要看板代码），
# 但 dashboard 镜像必须带上它，否则 COPY . /app 之后容器里没有 dashboard/app.py。

# ---- 版本控制 ----
.git/
.gitignore
.dockerignore
Dockerfile.dashboard.dockerignore

# ---- 机密与本地配置（运行时由 compose 的 env_file 注入）----
.env
.env.*
!.env.example

# ---- 运行期产物 ----
logs/
chroma_db/
agent/data/applications.db
agent/data/exports/
agent/data/resumes/*.json
agent/evaluation/failures/
evaluation/failures/

# ---- Python 缓存 ----
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 本地虚拟环境 / 编辑器 / 工具缓存 ----
.venv/
venv/
.idea/
.vscode/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
